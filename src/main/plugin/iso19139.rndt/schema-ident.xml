<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://geonetwork-opensource.org/schemas/schema-ident" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://geonetwork-opensource.org/schemas/schema-ident http://geonetwork-opensource.org/schemas/schema-ident/schema-ident.xsd">
  <!-- Italian geographic metadata schema based on ISO19139 (RNDT)-->
  <name>iso19139.rndt</name>
  <id>cce12b40-3bf2-11e3-aa6e-0800200c9a66</id>
  <version>2.0</version>
  <appMinorVersionSupported>4.4.0</appMinorVersionSupported>

  <title xml:lang="en">RNDT v2.0 (Based on iso19139:2007)</title>
  <title xml:lang="it">RNDT v2.0 (Basato su iso19139:2007)</title>

  <description xml:lang="en">
    Formato di metadati conforme alle specifiche pubblicate dal
    Repertorio Nazionale dei Dati Territoriali (RNDT),
    implementando le regole espresse nella
    "Guida operativa per la compilazione dei metadati RNDT"
    v.3.0 del 12/05/2020.
  </description>

  <description xml:lang="it">
    Formato di metadati conforme alle specifiche pubblicate dal
    Repertorio Nazionale dei Dati Territoriali (RNDT),
    implementando le regole espresse nella
    "Guida operativa per la compilazione dei metadati RNDT"
    v.3.0 del 12/05/2020.
  </description>

  <depends>iso19139</depends>

  <!-- schemaLocation: CSW2 AP ISO schema, one of those allowed by requirement C.1 (Manuale RNDT 2
       v3.1), as for iso19139 in GeoNetwork 4. GeoNetwork validates a record against the schemaLocation
       it declares and writes this value at every save: gmd.xsd alone does not import gmx, and every
       gmx:Anchor required by the RNDT 2.0 guidelines failed the XSD validation. -->
  <schemaLocation>http://www.isotc211.org/2005/gmd http://schemas.opengis.net/csw/2.0.2/profiles/apiso/1.0.0/apiso.xsd</schemaLocation>

  <!-- metadataStandardName da requisito RC.6 -->
  <!-- metadataStandardVersion da requisito RC.6 -->

  <!-- TODO: notare che la Raccomandazione RC.4 raccomanda un Anchor, quindi
             il test dell'autodetect dovrebbe includere anche questo contenuto:

      <gmd:metadataStandardName>
          <gmx:Anchor xlink:href="https://registry.geodati.gov.it/document/lg-rndt">Linee Guida RNDT</gmx:Anchor>
      </gmd:metadataStandardName>
  -->
  <autodetect xmlns:gmd="http://www.isotc211.org/2005/gmd" xmlns:gco="http://www.isotc211.org/2005/gco">
    <elements>
      <!-- The value is a regular expression on the text of the element
           (gco:CharacterString or gmx:Anchor, Manuale RNDT RC.6 / RC.4).
           Case insensitive: the AgID converter from the 2011 profile
           (rndt-md-converter) writes "Linee guida RNDT". -->
      <gmd:metadataStandardName>
        <gco:CharacterString>(?i)Linee Guida RNDT</gco:CharacterString>
      </gmd:metadataStandardName>
      <gmd:metadataStandardVersion>
        <gco:CharacterString>2.0</gco:CharacterString>
      </gmd:metadataStandardVersion>
    </elements>
  </autodetect>

  <readwriteUuid>true</readwriteUuid>
</schema>
